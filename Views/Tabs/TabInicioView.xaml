<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Tabs.TabInicioView">
    <VerticalStackLayout Spacing="12" Padding="10">

        <HorizontalStackLayout Spacing="8">
            <Label Text="PID" TextColor="White" VerticalOptions="Center" WidthRequest="40" />
            <Entry x:Name="txtPID" WidthRequest="140" BackgroundColor="#202020" TextColor="White" FontSize="14" />
            <Button Text="Generar" WidthRequest="90" HeightRequest="40" CornerRadius="8" BackgroundColor="#4040FF" TextColor="White" Clicked="OnGeneratePID" />
            <ImageButton Source="shiny_btn.png" WidthRequest="40" HeightRequest="40" BackgroundColor="#202020" CornerRadius="20" Padding="4" Clicked="OnGenerateShinyPID" />
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="LayoutEC" Spacing="8" IsVisible="False" Padding="0,5">
            <Label Text="EC" TextColor="White" VerticalOptions="Center" WidthRequest="40" />
            <Entry x:Name="txtEC" WidthRequest="140" BackgroundColor="#202020" TextColor="White" FontSize="14" IsReadOnly="True" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Género:" TextColor="White" WidthRequest="60"/>
            <Picker x:Name="GenderPicker" TextColor="White" BackgroundColor="#303030">
                <Picker.Items>
                    <x:String>♂ Macho</x:String>
                    <x:String>♀ Hembra</x:String>
                    <x:String>Sin género</x:String>
                </Picker.Items>
            </Picker>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label x:Name="lblEspecie" Text="Especie:" TextColor="White" WidthRequest="60"/>
            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AbrirBuscador_Tapped"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto">
                    <Label x:Name="lblPokemonSeleccionado" Text="Selecciona un Pokémon..." TextColor="White" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                    <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center"/>
                </Grid>
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Mote:" TextColor="White" WidthRequest="60"/>
            <Entry x:Name="NicknameEntry" TextColor="White" WidthRequest="150" BackgroundColor="#303030"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label Text="EXP:" TextColor="White" WidthRequest="60"/>
            <Entry x:Name="ExpEntry" Keyboard="Numeric" WidthRequest="80" TextColor="White" BackgroundColor="#303030"/>
            <Label Text="Nivel:" TextColor="White"/>
            <Entry x:Name="LevelEntry" Keyboard="Numeric" WidthRequest="60" TextColor="White" BackgroundColor="#303030"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label x:Name="lblNaturaleza" Text="Naturaleza:" TextColor="White" WidthRequest="80"/>
            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AbrirBuscadorNaturaleza_Tapped"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto">
                    <Label x:Name="lblNaturalezaSeleccionado" Text="Selecciona..." TextColor="White" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="▼" TextColor="Gray"/>
                </Grid>
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label x:Name="lblEstadoNat" Text="Estado:" TextColor="White" WidthRequest="80"/>
            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AbrirBuscadorEstadoNaturaleza_Tapped"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto">
                    <Label x:Name="lblNaturalezaEstadoSeleccionado" Text="Selecciona..." TextColor="White" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="▼" TextColor="Gray"/>
                </Grid>
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="LayoutForma" Spacing="10" IsVisible="False">
            <Label Text="Forma:" TextColor="White" WidthRequest="80" VerticalOptions="Center"/>
            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AbrirBuscadorForma_Tapped"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto">
                    <Label x:Name="lblFormaSeleccionada" Text="Normal" TextColor="White" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="▼" TextColor="Gray" Margin="5,0,0,0"/>
                </Grid>
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Objeto:" TextColor="White" WidthRequest="80"/>
            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AbrirBuscadorObjeto_Tapped"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto">
                    <Label x:Name="lblObjetoSeleccionado" Grid.Column="0" Text="(Ninguno)" TextColor="White" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                    <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center"/>
                </Grid>
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label x:Name="lblHabilidad" Text="Habilidad:" TextColor="White" WidthRequest="80"/>
            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AbrirBuscadorHabilidad_Tapped"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto">
                    <Label x:Name="lblHabilidadSeleccionado" Text="Selecciona..." TextColor="White" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="▼" TextColor="Gray"/>
                </Grid>
            </Border>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Felicidad:" TextColor="White" WidthRequest="80"/>
            <Entry x:Name="FriendshipEntry" Keyboard="Numeric" WidthRequest="60" TextColor="White" BackgroundColor="#303030"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Idioma:" TextColor="White" WidthRequest="80"/>
            <Picker x:Name="LanguagePicker" TextColor="White" BackgroundColor="#303030">
                <Picker.Items>
                    <x:String>ENG</x:String>
                    <x:String>SPA</x:String>
                    <x:String>FRE</x:String>
                    <x:String>GER</x:String>
                    <x:String>JPN</x:String>
                    <x:String>KOR</x:String>
                    <x:String>CHN</x:String>
                </Picker.Items>
            </Picker>
        </HorizontalStackLayout>

        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="5">
            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                <CheckBox x:Name="EggCheck" Color="White" CheckedChanged="OnEggCheckedChanged"/>
                <Label Text="Huevo" TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                <CheckBox x:Name="InfectedCheck" Color="White"/>
                <Label Text="Infectado" TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                <CheckBox x:Name="CuredCheck" Color="White"/>
                <Label Text="Curado" TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <Border x:Name="BorderExtra" IsVisible="False" Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,15,0,0">
            <VerticalStackLayout Spacing="10">

                <Grid x:Name="GridCatchRate" IsVisible="False" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" WidthRequest="70">
                        <Label Text="Catch Rate" TextColor="Gray" FontSize="11"/>
                        <Entry x:Name="txtCatchRate" Text="255" Keyboard="Numeric" TextColor="White" BackgroundColor="#202020" FontSize="13" TextChanged="OnCatchRateChanged"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="Clear" HeightRequest="35" Padding="10,0" FontSize="12" BackgroundColor="#404040" TextColor="White" Clicked="OnClearClicked" VerticalOptions="End"/>
                    <Button Grid.Column="3" Text="Reset" HeightRequest="35" Padding="10,0" FontSize="12" BackgroundColor="#404040" TextColor="White" Clicked="OnResetClicked" VerticalOptions="End"/>
                </Grid>

                <HorizontalStackLayout x:Name="LayoutNSparkle" Spacing="5" IsVisible="False">
                    <CheckBox x:Name="chkNSparkle" Color="Cyan" CheckedChanged="OnNSparkleChanged"/>
                    <Label Text="N's Sparkle (Gen 5)" TextColor="White" VerticalOptions="Center" FontSize="12"/>
                </HorizontalStackLayout>

                <VerticalStackLayout x:Name="LayoutShadowFields" Spacing="10" IsVisible="False">
                    <BoxView HeightRequest="1" Color="#333" Margin="0,5"/>

                    <Grid ColumnDefinitions="*, *">
                        <Label Grid.Column="0" Text="Datos Shadow" FontAttributes="Bold" TextColor="Cyan" FontSize="11" VerticalOptions="Center"/>
                        <HorizontalStackLayout x:Name="LayoutActive" Grid.Column="1" Spacing="5" HorizontalOptions="End">
                            <CheckBox x:Name="chkActive" Color="Cyan" IsChecked="True"/>
                            <Label Text="Active" TextColor="White" VerticalOptions="Center" FontSize="12"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Shadow ID" TextColor="Gray" FontSize="11"/>
                            <Entry x:Name="txtShadowID" Text="0" Keyboard="Numeric" TextColor="White" BackgroundColor="#202020" FontSize="13" TextChanged="OnShadowIDChanged"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Heart Gauge" TextColor="Gray" FontSize="11"/>
                            <Entry x:Name="txtHeartGauge" Text="0" Keyboard="Numeric" TextColor="White" BackgroundColor="#202020" FontSize="13" TextChanged="OnHeartGaugeChanged"/>
                        </VerticalStackLayout>
                    </Grid>

                    <HorizontalStackLayout Spacing="5">
                        <CheckBox x:Name="chkIsShadow" Color="Cyan" CheckedChanged="OnShadowChanged"/>
                        <Label Text="Es Shadow" TextColor="White" VerticalOptions="Center" FontSize="12"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentView>
