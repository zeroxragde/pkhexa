<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Tabs.TabStatsView">

    <VerticalStackLayout Spacing="15" Padding="10">

        <Border Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" StrokeShape="RoundRectangle 10" Padding="15">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                  ColumnSpacing="5" 
                  RowSpacing="8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition x:Name="ColIV" Width="*"/>
                    <ColumnDefinition x:Name="ColEV" Width="*"/>
                    <ColumnDefinition x:Name="ColAV" Width="*"/>
                    <ColumnDefinition x:Name="ColGV" Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Text="Stat" FontAttributes="Bold" TextColor="Gray" FontSize="11" HorizontalOptions="Start" VerticalOptions="End"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Base" FontAttributes="Bold" TextColor="Gray" FontSize="11" HorizontalOptions="Center" VerticalOptions="End"/>
                <Label x:Name="HeaderIV" Grid.Row="0" Grid.Column="2" Text="IVs" FontAttributes="Bold" TextColor="Cyan" FontSize="11" HorizontalOptions="Center" VerticalOptions="End"/>
                <Label x:Name="HeaderEV" Grid.Row="0" Grid.Column="3" Text="EVs" FontAttributes="Bold" TextColor="Orange" FontSize="11" HorizontalOptions="Center" VerticalOptions="End"/>
                <Label x:Name="HeaderAV" Grid.Row="0" Grid.Column="4" Text="AVs" FontAttributes="Bold" TextColor="#90EE90" FontSize="11" HorizontalOptions="Center" VerticalOptions="End"/>
                <Label x:Name="HeaderGV" Grid.Row="0" Grid.Column="5" Text="GVs" FontAttributes="Bold" TextColor="#FFD700" FontSize="11" HorizontalOptions="Center" VerticalOptions="End"/>
                <Label Grid.Row="0" Grid.Column="6" Text="Total" FontAttributes="Bold" TextColor="White" FontSize="11" HorizontalOptions="Center" VerticalOptions="End"/>

                <Label Grid.Row="1" Text="HP" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label x:Name="lblBaseHP" Grid.Row="1" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Entry x:Name="txtIVHP" Grid.Row="1" Grid.Column="2" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtEVHP" Grid.Row="1" Grid.Column="3" Text="0" MaxLength="3" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtAVHP" Grid.Row="1" Grid.Column="4" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtGVHP" Grid.Row="1" Grid.Column="5" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Label x:Name="lblStatHP" Grid.Row="1" Grid.Column="6" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                <Label Grid.Row="2" Text="Atk" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label x:Name="lblBaseAtk" Grid.Row="2" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Entry x:Name="txtIVAtk" Grid.Row="2" Grid.Column="2" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtEVAtk" Grid.Row="2" Grid.Column="3" Text="0" MaxLength="3" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtAVAtk" Grid.Row="2" Grid.Column="4" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtGVAtk" Grid.Row="2" Grid.Column="5" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Label x:Name="lblStatAtk" Grid.Row="2" Grid.Column="6" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                <Label Grid.Row="3" Text="Def" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label x:Name="lblBaseDef" Grid.Row="3" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Entry x:Name="txtIVDef" Grid.Row="3" Grid.Column="2" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtEVDef" Grid.Row="3" Grid.Column="3" Text="0" MaxLength="3" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtAVDef" Grid.Row="3" Grid.Column="4" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtGVDef" Grid.Row="3" Grid.Column="5" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Label x:Name="lblStatDef" Grid.Row="3" Grid.Column="6" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                <Label Grid.Row="4" Text="SpA" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label x:Name="lblBaseSpa" Grid.Row="4" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Entry x:Name="txtIVSpa" Grid.Row="4" Grid.Column="2" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtEVSpa" Grid.Row="4" Grid.Column="3" Text="0" MaxLength="3" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtAVSpa" Grid.Row="4" Grid.Column="4" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtGVSpa" Grid.Row="4" Grid.Column="5" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Label x:Name="lblStatSpa" Grid.Row="4" Grid.Column="6" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                <Label Grid.Row="5" Text="SpD" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label x:Name="lblBaseSpd" Grid.Row="5" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Entry x:Name="txtIVSpd" Grid.Row="5" Grid.Column="2" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtEVSpd" Grid.Row="5" Grid.Column="3" Text="0" MaxLength="3" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtAVSpd" Grid.Row="5" Grid.Column="4" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtGVSpd" Grid.Row="5" Grid.Column="5" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Label x:Name="lblStatSpd" Grid.Row="5" Grid.Column="6" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                <Label Grid.Row="6" Text="Spe" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label x:Name="lblBaseSpe" Grid.Row="6" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Entry x:Name="txtIVSpe" Grid.Row="6" Grid.Column="2" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtEVSpe" Grid.Row="6" Grid.Column="3" Text="0" MaxLength="3" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtAVSpe" Grid.Row="6" Grid.Column="4" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Entry x:Name="txtGVSpe" Grid.Row="6" Grid.Column="5" Text="0" MaxLength="2" Keyboard="Numeric" HeightRequest="35" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                <Label x:Name="lblStatSpe" Grid.Row="6" Grid.Column="6" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                <Grid Grid.Row="7" Grid.ColumnSpan="7" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,15,0,0">
                    <Button Grid.Column="0" Text="Random IVs" HeightRequest="35" FontSize="11" BackgroundColor="#303030" TextColor="White" CornerRadius="5" Clicked="OnRandomizeIVs"/>
                    <Button Grid.Column="1" Text="Random EVs" HeightRequest="35" FontSize="11" BackgroundColor="#303030" TextColor="White" CornerRadius="5" Clicked="OnRandomizeEVs"/>
                    <Button Grid.Column="2" Text="Randomize" HeightRequest="35" FontSize="11" BackgroundColor="#303030" TextColor="White" CornerRadius="5" Clicked="OnRandomizeAll"/>
                </Grid>

            </Grid>
        </Border>

        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,5,0,0">
            <Label x:Name="lblTotalIVs" Text="IV Total: 0/186" TextColor="Cyan" FontSize="11"/>
            <Label x:Name="lblTotalEVs" Text="EV Total: 0/510" TextColor="Orange" FontSize="11"/>
            <Label x:Name="lblTotalContest" Text="Contest Total: 0" TextColor="Pink" FontSize="11" IsVisible="False"/>
        </HorizontalStackLayout>

        <Border x:Name="BorderContests" Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" StrokeShape="RoundRectangle 10" Padding="15" IsVisible="False">
            <VerticalStackLayout Spacing="10">
                <Label Text="Contest Stats (Concursos)" FontAttributes="Bold" TextColor="#AAAAAA" FontSize="13"/>
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">

                    <Label Grid.Row="0" Grid.Column="0" Text="Cool" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="Beauty" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Text="Cute" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                    <Label Grid.Row="0" Grid.Column="3" Text="Sheen" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>

                    <Entry x:Name="txtContestCool" Grid.Row="1" Grid.Column="0" HeightRequest="35" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                    <Entry x:Name="txtContestBeauty" Grid.Row="1" Grid.Column="1" HeightRequest="35" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                    <Entry x:Name="txtContestCute" Grid.Row="1" Grid.Column="2" HeightRequest="35" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                    <Entry x:Name="txtContestSheen" Grid.Row="1" Grid.Column="3" HeightRequest="35" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>

                    <Label Grid.Row="2" Grid.Column="0" Text="Smart" TextColor="Gray" FontSize="11" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    <Label Grid.Row="2" Grid.Column="1" Text="Tough" TextColor="Gray" FontSize="11" HorizontalOptions="Center" Margin="0,10,0,0"/>

                    <Entry x:Name="txtContestSmart" Grid.Row="3" Grid.Column="0" HeightRequest="35" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                    <Entry x:Name="txtContestTough" Grid.Row="3" Grid.Column="1" HeightRequest="35" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <HorizontalStackLayout x:Name="LayoutHiddenPower" Spacing="10" Margin="0,15,0,0">
            <Label Text="Hidden Power:" TextColor="Gray" FontSize="12"/>
            <Label x:Name="lblHiddenPowerType" Text="-" TextColor="White" FontAttributes="Bold"/>
            <Label Text="(60)" TextColor="Gray" FontSize="12"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="LayoutCharacteristic" Spacing="10" Margin="0,5,0,10">
            <Label Text="Characteristic:" TextColor="Gray" FontSize="12"/>
            <Label x:Name="lblCharacteristic" Text="-" TextColor="White"/>
        </HorizontalStackLayout>

        <Border x:Name="BorderGimmicks" Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" StrokeShape="RoundRectangle 10" Padding="15" IsVisible="False">
            <VerticalStackLayout Spacing="15">

                <HorizontalStackLayout x:Name="LayoutTera" Spacing="15" IsVisible="False">
                    <Label Text="Tera Type:" TextColor="White" WidthRequest="80" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="#303030" Padding="0" HeightRequest="40" HorizontalOptions="FillAndExpand">
                        <Picker x:Name="TeraTypePicker" TextColor="White" TitleColor="Gray" BackgroundColor="Transparent" SelectedIndexChanged="OnTeraTypeChanged"/>
                    </Border>
                </HorizontalStackLayout>

                <Grid x:Name="LayoutDynamax" ColumnDefinitions="Auto, Auto, *" IsVisible="False">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Label Text="D-Level:" TextColor="White" VerticalOptions="Center"/>
                        <Entry x:Name="txtDynamaxLevel" Text="0" WidthRequest="50" HeightRequest="35" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnDynamaxLevelChanged"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="10" Margin="25,0,0,0" VerticalOptions="Center">
                        <CheckBox x:Name="chkGigantamax" Color="Cyan" CheckedChanged="OnGigantamaxChanged"/>
                        <Label Text="Gigantamax" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <HorizontalStackLayout x:Name="LayoutTeraOriginal" Spacing="15" IsVisible="False">
                    <Label Text="Tera OG:" TextColor="White" WidthRequest="80" VerticalOptions="Center"/>
                    <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="#303030" Padding="0" HeightRequest="40" HorizontalOptions="FillAndExpand">
                        <Picker x:Name="TeraTypeOriginalPicker" TextColor="White" TitleColor="Gray" BackgroundColor="Transparent" IsEnabled="False"/>
                    </Border>
                </HorizontalStackLayout>

                <HorizontalStackLayout x:Name="LayoutAlphaNoble" Spacing="20" Margin="0,10,0,0">
                    <HorizontalStackLayout x:Name="hsAlpha" Spacing="5">
                        <CheckBox x:Name="chkAlpha" Color="#FF4444" VerticalOptions="Center"/>
                        <Label Text="Alpha" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="hsNoble" IsVisible="False" Spacing="5">
                        <CheckBox x:Name="chkNoble" Color="Gold" VerticalOptions="Center"/>
                        <Label Text="Noble" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentView>
