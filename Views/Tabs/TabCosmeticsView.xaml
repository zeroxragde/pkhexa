<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Tabs.TabCosmeticsView">




    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">

                <Border Grid.Column="0" Stroke="#444" StrokeThickness="1" BackgroundColor="#151515" StrokeShape="RoundRectangle 10" Padding="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Marcas (Markings)" TextColor="#888" FontSize="10" HorizontalOptions="Center"/>

                        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="0">
                            <Button x:Name="btnMarkCircle" Text="●" Clicked="ToggleMarking_Clicked" TextColor="Gray" BackgroundColor="Transparent" FontSize="20" Padding="0"/>
                            <Button x:Name="btnMarkTriangle" Text="▲" Clicked="ToggleMarking_Clicked" TextColor="Gray" BackgroundColor="Transparent" FontSize="20" Padding="0" Grid.Column="1"/>
                            <Button x:Name="btnMarkSquare" Text="■" Clicked="ToggleMarking_Clicked" TextColor="Gray" BackgroundColor="Transparent" FontSize="20" Padding="0" Grid.Column="2"/>
                            <Button x:Name="btnMarkHeart" Text="♥" Clicked="ToggleMarking_Clicked" TextColor="Gray" BackgroundColor="Transparent" FontSize="20" Padding="0" Grid.Column="3"/>
                            <Button x:Name="btnMarkStar" Text="★" Clicked="ToggleMarking_Clicked" TextColor="Gray" BackgroundColor="Transparent" FontSize="20" Padding="0" Grid.Column="4"/>
                            <Button x:Name="btnMarkDiamond" Text="♦" Clicked="ToggleMarking_Clicked" TextColor="Gray" BackgroundColor="Transparent" FontSize="20" Padding="0" Grid.Column="5"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid Grid.Column="1" WidthRequest="60" HeightRequest="60">

                    <Border x:Name="boxTera" Stroke="#444" BackgroundColor="#151515" StrokeShape="RoundRectangle 10" IsVisible="False">
                        <Grid>
                            <Label Text="💎" HorizontalOptions="Center" VerticalOptions="Center" FontSize="24"/>
                            <Picker x:Name="pickerTeraType" Opacity="0.01" Title="Tera Type" SelectedIndexChanged="OnTeraTypeChanged"/>
                        </Grid>
                    </Border>

                    <Border x:Name="boxAlpha" Stroke="#444" BackgroundColor="#151515" StrokeShape="RoundRectangle 10" IsVisible="False">
                        <Label Text="💀" HorizontalOptions="Center" VerticalOptions="Center" FontSize="24" TextColor="#FF4444"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ToggleAlpha_Tapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>
            </Grid>

            <Grid ColumnDefinitions="Auto, Auto, Auto, *" ColumnSpacing="15">
                <Border Stroke="#333" WidthRequest="45" HeightRequest="45" StrokeShape="RoundRectangle 25" BackgroundColor="#202020">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ToggleFavorite_Tapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="lblFavorite" Text="❤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray"/>
                </Border>

                <HorizontalStackLayout Grid.Column="3" HorizontalOptions="End" Spacing="10" VerticalOptions="Center">
                    <Label x:Name="lblShinyIcon" Text="✨" FontSize="18" Opacity="0.1" TextColor="Gold"/>
                    <Label x:Name="lblPokerusIcon" Text="🦠" FontSize="18" Opacity="0.1" TextColor="Magenta"/>
                </HorizontalStackLayout>
            </Grid>

            <Border Stroke="#333" BackgroundColor="#121212" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Propiedades (Amistad/Afecto)" TextColor="#AAA" FontSize="12" FontAttributes="Bold"/>

                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="10" ColumnSpacing="15">
                        <VerticalStackLayout>
                            <Label Text="Amistad (Spirit)" TextColor="Gray" FontSize="10"/>
                            <Entry x:Name="nudSpirit" Text="0" Keyboard="Numeric" BackgroundColor="#222" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnStatInputChanged"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Afecto (Mood)" TextColor="Gray" FontSize="10"/>
                            <Entry x:Name="nudMood" Text="0" Keyboard="Numeric" BackgroundColor="#222" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnStatInputChanged"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1">
                            <Label Text="Saciedad (Walk)" TextColor="Gray" FontSize="10"/>
                            <Entry x:Name="nudWalkingMood" Text="0" Keyboard="Numeric" BackgroundColor="#222" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Fama (PokéStar)" TextColor="Gray" FontSize="10"/>
                            <Entry x:Name="nudFame" Text="0" Keyboard="Numeric" BackgroundColor="#222" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#333" BackgroundColor="#121212" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Dimensiones y CP" TextColor="#AAA" FontSize="12" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*, 80" RowDefinitions="Auto, Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Escala (0-255)" TextColor="Gray" FontSize="10"/>
                            <Entry x:Name="txtScale" Text="0" Keyboard="Numeric" BackgroundColor="#222" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnStatInputChanged"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0">
                            <Label Text="CP" TextColor="Gray" FontSize="10"/>
                            <Entry x:Name="txtCP" Text="0" Keyboard="Numeric" BackgroundColor="#222" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnStatInputChanged"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="RECUERDOS / CINTAS" BackgroundColor="#444" TextColor="White" HeightRequest="45" CornerRadius="8" Margin="0,10,0,0" Clicked="OpenRibbons_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>









</ContentView>
