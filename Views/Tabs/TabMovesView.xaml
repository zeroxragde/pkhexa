<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PkHexA.Views.Pickers"
             x:Class="PkHexA.Views.Tabs.TabMovesView">
    <VerticalStackLayout Spacing="15" Padding="10">

        <HorizontalStackLayout x:Name="LayoutAlphaMoves" 
                               Spacing="10" 
                               IsVisible="False"
                               HorizontalOptions="Center">
            <CheckBox x:Name="chkAlphaMoves" Color="#FF5555"/>
            <Label Text="Alpha / Dominante" TextColor="#FF5555" FontAttributes="Bold" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="5">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, 60, 60, 40" ColumnSpacing="8" Padding="0,4">
                <Label Grid.Column="2" Text="PP" TextColor="Gray" HorizontalOptions="Center" FontSize="12"/>
                <Label Grid.Column="3" Text="Más" TextColor="Gray" HorizontalOptions="Center" FontSize="12"/>
                <Label x:Name="lblHeaderMastery" Grid.Column="4" Text="M" TextColor="Gold" FontAttributes="Bold" HorizontalOptions="Center" FontSize="12" IsVisible="False"/>
            </Grid>

            <controls:MoveSelector x:Name="viewMove1" 
                                   Grid.Row="1" 
                                   OnStatsChanged="GuardarStats_Changed"
                                   MoveTapped="AbrirBuscadorMovimiento1_Tapped"/>

            <controls:MoveSelector x:Name="viewMove2" 
                                   Grid.Row="2" 
                                   OnStatsChanged="GuardarStats_Changed"
                                   MoveTapped="AbrirBuscadorMovimiento2_Tapped"/>

            <controls:MoveSelector x:Name="viewMove3" 
                                   Grid.Row="3" 
                                   OnStatsChanged="GuardarStats_Changed"
                                   MoveTapped="AbrirBuscadorMovimiento3_Tapped"/>

            <controls:MoveSelector x:Name="viewMove4" 
                                   Grid.Row="4" 
                                   OnStatsChanged="GuardarStats_Changed"
                                   MoveTapped="AbrirBuscadorMovimiento4_Tapped"/>

        </Grid>

        <VerticalStackLayout x:Name="SectionRelearn" Spacing="8" Margin="0,10,0,0">
            <Label Text="Recordar movimientos (Relearn)" TextColor="Gray" FontSize="12"/>
            <Grid ColumnDefinitions="*, 40" ColumnSpacing="5">
                <Border Grid.Column="0" Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" Padding="10" StrokeShape="RoundRectangle 5">
                    <VerticalStackLayout Spacing="5">
                        <Picker x:Name="pkRelearn1" Title="(Ninguno)" TextColor="White" BackgroundColor="Transparent"/>
                        <BoxView HeightRequest="1" Color="#333"/>
                        <Picker x:Name="pkRelearn2" Title="(Ninguno)" TextColor="White" BackgroundColor="Transparent"/>
                        <BoxView HeightRequest="1" Color="#333"/>
                        <Picker x:Name="pkRelearn3" Title="(Ninguno)" TextColor="White" BackgroundColor="Transparent"/>
                        <BoxView HeightRequest="1" Color="#333"/>
                        <Picker x:Name="pkRelearn4" Title="(Ninguno)" TextColor="White" BackgroundColor="Transparent"/>
                    </VerticalStackLayout>
                </Border>

                <Button Grid.Column="1" Text="↺" BackgroundColor="#3E3E42" TextColor="White" CornerRadius="5" VerticalOptions="Fill"/>
            </Grid>
        </VerticalStackLayout>

        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
            <Button x:Name="btnRelearnFlags" Grid.Column="0" Text="Marcas recuerdamov." BackgroundColor="#3E3E42" TextColor="White" FontSize="11" HeightRequest="40" CornerRadius="5"/>
            <Button x:Name="btnPlusFlags" Grid.Column="1" Text="Plus Flags" BackgroundColor="#3E3E42" TextColor="White" FontSize="11" HeightRequest="40" CornerRadius="5"/>
        </Grid>

    </VerticalStackLayout>
</ContentView>
