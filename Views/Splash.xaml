<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Splash" 
             BackgroundColor="#111"
             Title="Splash">







    <Grid RowDefinitions="*,Auto,*">

        <!-- Logo centrado -->
        <Image 
            Grid.Row="1"
            Source="splash_art.png"
            HeightRequest="160"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>

        <!-- Barra de progreso abajo -->
        <StackLayout 
            Grid.Row="2"
            Padding="40" 
            Spacing="15"
            HorizontalOptions="Fill"
            VerticalOptions="End">
            <Label 
                Text="Cargando..."
                x:Name="lblCargando"
                HorizontalOptions="Center"
                TextColor="White"
                FontSize="14"
                Opacity="0.8"/>

            <ProgressBar 
                x:Name="LoadingBar"
                Progress="0"
                HeightRequest="10" 
                
                ProgressColor="#00FFFF"  
                
                BackgroundColor="#333333"
                
                HorizontalOptions="FillAndExpand"
                Margin="0,0,0,50"/>
        </StackLayout>

    </Grid>









</ContentPage>