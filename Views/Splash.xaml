<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Splash" 
             BackgroundColor="#111"
             Title="Splash">


    <Grid>
        <VerticalStackLayout
            Spacing="25"
            HorizontalOptions="Center"
            VerticalOptions="CenterAndExpand">

            <!-- LOGO -->
            <Image
                Source="splash_art.png"
                Aspect="AspectFit"
                HeightRequest="240"
                HorizontalOptions="Center"/>

            <!-- TEXTO -->
            <Label
                Text="Preparando recursos..."
                TextColor="White"
                HorizontalOptions="Center"
                FontSize="16"
                Margin="0,10,0,0"/>

            <!-- PROGRESS BAR -->
            <ProgressBar
                x:Name="LoadingBar"
                Progress="0"
                HeightRequest="6"
                WidthRequest="240"
                HorizontalOptions="Center"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
