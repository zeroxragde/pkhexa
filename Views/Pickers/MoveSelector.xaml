<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Pickers.MoveSelector">

    <Grid ColumnDefinitions="Auto, *, 60, 60, 40" 
          ColumnSpacing="8" 
          Padding="0,4"
          HeightRequest="55">

        <Label x:Name="lblAlert" Grid.Column="0" Text="⚠️" TextColor="Red" FontSize="18" VerticalOptions="Center" IsVisible="False"/>

        <Border Grid.Column="1" Stroke="Gray" StrokeShape="RoundRectangle 8" BackgroundColor="#2D2D30" Padding="10,0">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTapped"/>
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                <Image x:Name="imgType" Grid.Column="0" WidthRequest="30" HeightRequest="30" VerticalOptions="Center"/>
                <Label x:Name="lblMoveName" Grid.Column="1" Text="(Ninguno)" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Stroke="#505050" StrokeShape="RoundRectangle 5" BackgroundColor="#151515" Padding="0">
            <Entry x:Name="entryPP" 
                   Text="0" 
                   TextColor="White" 
                   FontSize="14" 
                   HorizontalTextAlignment="Center" 
                   VerticalTextAlignment="Center" 
                   Keyboard="Numeric" 
                   MaxLength="3" 
                   Completed="OnStatInputChanged" 
                   Unfocused="OnStatInputChanged"/>
        </Border>

        <Border Grid.Column="3" Stroke="#505050" StrokeShape="RoundRectangle 5" BackgroundColor="#151515" Padding="0">
            <Picker x:Name="pickerPPUps" 
                    TextColor="Aqua" 
                    FontSize="14" 
                    HorizontalTextAlignment="Center" 
                    Title="" 
                    SelectedIndexChanged="OnStatInputChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>0</x:String>
                        <x:String>1</x:String>
                        <x:String>2</x:String>
                        <x:String>3</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Border>

        <CheckBox x:Name="chkMastery" Grid.Column="4" Color="Gold" VerticalOptions="Center" HorizontalOptions="Center" CheckedChanged="OnStatInputChanged"/>

    </Grid>
</ContentView>