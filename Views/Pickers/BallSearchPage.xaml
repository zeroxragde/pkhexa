<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Pickers.BallSearchPage"
             Title="BallSearchPage">
    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="10">

        <!-- BUSCADOR -->
        <SearchBar Grid.Row="0"
                   x:Name="BarraBusqueda"
                   Placeholder="Buscar ball..."
                   PlaceholderColor="Gray"
                   TextColor="White"
                   BackgroundColor="#202020"
                   CancelButtonColor="Aqua"
                   TextChanged="OnBusquedaChanged" />

        <!-- LISTA CON ICONOS -->
        <CollectionView Grid.Row="1"
                        x:Name="ListaBalls"
                        SelectionMode="Single"
                        SelectionChanged="OnBallSeleccionada">

            <!-- DISEÑO DE REJILLA O LISTA (Uso lista vertical aquí para ver nombre claro) -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="Transparent" Margin="0,5" Padding="10" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 10">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#303080" />
                                        <Setter Property="Stroke" Value="Aqua" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="50, *">
                            <!-- ÍCONO DE LA BALL -->
                            <!-- Usamos un Binding a una URL o Recurso -->
                            <Image Source="{Binding ImageUrl}" 
                                   HeightRequest="40" 
                                   WidthRequest="40" 
                                   Aspect="AspectFit"
                                   VerticalOptions="Center"/>

                            <!-- NOMBRE -->
                            <Label Grid.Column="1" 
                                   Text="{Binding Text}" 
                                   TextColor="White" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" 
                                   Margin="15,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>