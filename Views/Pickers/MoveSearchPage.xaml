<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Pickers.MoveSearchPage"
             BackgroundColor="Black"
             Title="Seleccionar Movimiento">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="10">

        <SearchBar Grid.Row="0"
                   Placeholder="Buscar movimiento..."
                   PlaceholderColor="Gray"
                   TextColor="White"
                   BackgroundColor="#202020"
                   CancelButtonColor="Aqua"
                   TextChanged="OnBusquedaChanged"/>

        <CollectionView Grid.Row="1"
                        x:Name="ListaMovimientos"
                        SelectionMode="Single"
                        SelectionChanged="OnMoveSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="Transparent" Margin="0,5" Padding="5">
                        <Grid ColumnDefinitions="40, *">
                            <Image Grid.Column="0"
                                   x:Name="imgTipo"
                                   Source="{Binding TipoImagen}"
                                   HeightRequest="30"
                                   WidthRequest="30"
                                   Aspect="AspectFit"/>

                            <Label Grid.Column="1"
                                   Text="{Binding Nombre}"
                                   TextColor="White"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator x:Name="LoadingSpinner"
                           Grid.Row="1"
                           IsRunning="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="Aqua"/>
    </Grid>
</ContentPage>