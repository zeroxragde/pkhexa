<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Pickers.ItemSearchPage"
             Title="ItemSearchPage">


    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="10">

        <SearchBar Grid.Row="0"
                   x:Name="BarraBusqueda"
                   Placeholder="Buscar objeto..."
                   PlaceholderColor="Gray"
                   TextColor="White"
                   BackgroundColor="#202020"
                   CancelButtonColor="Aqua"
                   TextChanged="OnBusquedaChanged" />

        <CollectionView Grid.Row="1"
                        x:Name="ListaItems"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSeleccionado">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="Transparent" Margin="0,5" Padding="15" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 10">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#303080" />
                                        <Setter Property="Stroke" Value="Aqua" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Label Text="{Binding Text}" 
                               TextColor="White" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>



</ContentPage>