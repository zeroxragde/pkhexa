<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.Editor"
             BackgroundColor="#101010"
             x:Name="winEditorMain"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" 
          Padding="15" 
          RowSpacing="10">

        <HorizontalStackLayout Grid.Row="0" Spacing="30" HorizontalOptions="Center" Margin="0,10,0,15">

            <VerticalStackLayout Spacing="5">
                <ImageButton Source="edit_pkm.png" WidthRequest="60" HeightRequest="60"
                             BackgroundColor="#202020" CornerRadius="30"
                             Clicked="OnEditPkmClicked" />
                <Label x:Name="lblBtnEditar" Text="Editar" TextColor="White" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <ImageButton Source="edit_user.png" WidthRequest="60" HeightRequest="60"
                             BackgroundColor="#202020" CornerRadius="30"
                             Clicked="OnEditUserClicked" />
                <Label x:Name="lblBtnTrainer" Text="Entrenador" TextColor="White" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <ImageButton Source="add_box.png" WidthRequest="60" HeightRequest="60"
                             BackgroundColor="#202020" CornerRadius="30"
                             Clicked="OnAddPokemonClicked" />
                <Label x:Name="lblBtnNuevo" Text="Nuevo" TextColor="White" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="5" HorizontalOptions="Center">

            <Label x:Name="lblEditorCajas"
                   Text="Editor de Cajas"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>

            <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                <Label x:Name="lblCajaActual"
                       Text="Caja Actual:" 
                       TextColor="#AAAAAA" 
                       VerticalOptions="Center"/>

                <Border Stroke="Gray" StrokeThickness="1" BackgroundColor="#202020" Padding="10,0" HeightRequest="40">
                    <Picker x:Name="BoxPicker"
                            TextColor="White"
                            TitleColor="Gray"
                            WidthRequest="150"
                            SelectedIndexChanged="OnBoxChanged"/>
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="2" Margin="0,5">

            <Image Source="pkhex_background_tile.png" 
                   Aspect="AspectFill" 
                   Opacity="0.5"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"/>

            <Grid x:Name="BoxGridContainer"
                  RowDefinitions="*,*,*,*,*"
                  ColumnDefinitions="*,*,*,*,*,*"
                  ColumnSpacing="2" RowSpacing="2" Padding="4"
                  BackgroundColor="Transparent">
            </Grid>
        </Grid>

        <Label x:Name="lblEquipoParty" 
               Grid.Row="3" 
               Text="Equipo Pokémon (Party)" 
               TextColor="#AAAAAA" FontSize="14" FontAttributes="Bold" Margin="5,5,0,0"/>

        <Grid Grid.Row="4" HeightRequest="110">
            <Grid x:Name="PartyGridContainer"
                  RowDefinitions="*,*"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="4" RowSpacing="4" Padding="4"
                  BackgroundColor="#151515">
            </Grid>
        </Grid>

        <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">

            <Button x:Name="btnGuardar"
                    Grid.Column="0"
                    Text="Guardar Save"
                    BackgroundColor="#303080" 
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    Clicked="OnSaveClicked"/>

            <Button x:Name="btnExportarPkm"
                    Grid.Column="1"
                    Text="Exportar PKM"
                    BackgroundColor="#008080" 
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    Clicked="OnExportPkmClicked"/>
        </Grid>

        <Button x:Name="btnVolver"
                Grid.Row="6"
                Text="Volver"
                BackgroundColor="#252525"
                TextColor="#AAAAAA"
                CornerRadius="8"
                HeightRequest="40"
                Clicked="OnExitClicked" />

    </Grid>
</ContentPage>