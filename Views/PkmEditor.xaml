<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PkHexA.Views.PkmEditor"
             BackgroundColor="Black"
             x:Name="winPkmEditor"
             Title="PkmEditor">

    <Grid RowDefinitions="Auto,Auto,*" Padding="15">

        <ScrollView Orientation="Horizontal" Grid.Row="0" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="StackBotones" Spacing="10" Padding="0,5">
     
                <Button Text="Inicio" 
                x:Name="btnTabInicio" 
                Style="{StaticResource TabButtonSelectedStyle}" 
                Clicked="OnTabClicked"/>

                <Button Text="Encuentro" 
                x:Name="btnTabEncuentro" 
                Style="{StaticResource TabButtonStyle}" 
                Clicked="OnTabClicked"/>

                <Button Text="Estad." 
                x:Name="btnTabStats" 
                Style="{StaticResource TabButtonStyle}" 
                Clicked="OnTabClicked"/>

                <Button Text="Movimiento" 
                x:Name="btnTabMoves" 
                Style="{StaticResource TabButtonStyle}" 
                Clicked="OnTabClicked"/>

                <Button Text="Cosmética" 
                x:Name="btnTabCosmetics" 
                Style="{StaticResource TabButtonStyle}" 
                Clicked="OnTabClicked"/>

                <Button Text="EO/Misc" 
                x:Name="btnTabOT" 
                Style="{StaticResource TabButtonStyle}" 
                Clicked="OnTabClicked"/>
            </HorizontalStackLayout>
        </ScrollView>

        <Label Grid.Row="1" Text="Editor de Pokémon" x:Name="tabInicioEditPkm"
               HorizontalOptions="Center" FontSize="26" FontAttributes="Bold" Margin="0,15" TextColor="White"/>

        <ScrollView Grid.Row="2">
            <ContentView x:Name="TabContent">
                <Grid x:Name="GridPaneles">
                    <!--TAB INICIO -->
                    <VerticalStackLayout x:Name="TabInicio" Spacing="12" Padding="10">

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="PID" TextColor="White" VerticalOptions="Center" WidthRequest="40" />
                            <Entry x:Name="txtPID" WidthRequest="140" BackgroundColor="#202020" TextColor="White" FontSize="14" />
                            <Button Text="Generar" WidthRequest="90" HeightRequest="40" CornerRadius="8" BackgroundColor="#4040FF" TextColor="White" Clicked="OnGeneratePID" />
                            <ImageButton Source="shiny_btn.png" WidthRequest="40" HeightRequest="40" BackgroundColor="#202020" CornerRadius="20" Padding="4" Clicked="OnGenerateShinyPID" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout x:Name="LayoutEC" Spacing="8" IsVisible="False" Padding="0,5">
                            <Label Text="EC" TextColor="White" VerticalOptions="Center" WidthRequest="40" />
                            <Entry x:Name="txtEC" WidthRequest="140" BackgroundColor="#202020" TextColor="White" FontSize="14" IsReadOnly="True" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Género:" TextColor="White" WidthRequest="60"/>
                            <Picker x:Name="GenderPicker" TextColor="White" BackgroundColor="#303030">
                                <Picker.Items>
                                    <x:String>♂ Macho</x:String>
                                    <x:String>♀ Hembra</x:String>
                                    <x:String>Sin género</x:String>
                                </Picker.Items>
                            </Picker>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label x:Name="lblEspecie" Text="Especie:" TextColor="White" WidthRequest="60"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AbrirBuscador_Tapped"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="lblPokemonSeleccionado" Text="Selecciona un Pokémon..." TextColor="White" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Mote:" TextColor="White" WidthRequest="60"/>
                            <Entry x:Name="NicknameEntry" TextColor="White" WidthRequest="150" BackgroundColor="#303030"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="EXP:" TextColor="White" WidthRequest="60"/>
                            <Entry x:Name="ExpEntry" Keyboard="Numeric" WidthRequest="80" TextColor="White" BackgroundColor="#303030"/>
                            <Label Text="Nivel:" TextColor="White"/>
                            <Entry x:Name="LevelEntry" Keyboard="Numeric" WidthRequest="60" TextColor="White" BackgroundColor="#303030"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label x:Name="lblNaturaleza" Text="Naturaleza:" TextColor="White" WidthRequest="80"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AbrirBuscadorNaturaleza_Tapped"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="lblNaturalezaSeleccionado" Text="Selecciona..." TextColor="White" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="▼" TextColor="Gray"/>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label x:Name="lblEstadoNat" Text="Estado:" TextColor="White" WidthRequest="80"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AbrirBuscadorEstadoNaturaleza_Tapped"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="lblNaturalezaEstadoSeleccionado" Text="Selecciona..." TextColor="White" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="▼" TextColor="Gray"/>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout x:Name="LayoutForma" Spacing="10" IsVisible="False">
                            <Label Text="Forma:" TextColor="White" WidthRequest="80" VerticalOptions="Center"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AbrirBuscadorForma_Tapped"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="lblFormaSeleccionada" Text="Normal" TextColor="White" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="▼" TextColor="Gray" Margin="5,0,0,0"/>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Objeto:" TextColor="White" WidthRequest="80"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AbrirBuscadorObjeto_Tapped"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="lblObjetoSeleccionado" Grid.Column="0" Text="(Ninguno)" TextColor="White" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label x:Name="lblHabilidad" Text="Habilidad:" TextColor="White" WidthRequest="80"/>
                            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="15,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AbrirBuscadorHabilidad_Tapped"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="lblHabilidadSeleccionado" Text="Selecciona..." TextColor="White" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="▼" TextColor="Gray"/>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Felicidad:" TextColor="White" WidthRequest="80"/>
                            <Entry x:Name="FriendshipEntry" Keyboard="Numeric" WidthRequest="60" TextColor="White" BackgroundColor="#303030"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Idioma:" TextColor="White" WidthRequest="80"/>
                            <Picker x:Name="LanguagePicker" TextColor="White" BackgroundColor="#303030">
                                <Picker.Items>
                                    <x:String>ENG</x:String>
                                    <x:String>SPA</x:String>
                                    <x:String>FRE</x:String>
                                    <x:String>GER</x:String>
                                    <x:String>JPN</x:String>
                                    <x:String>KOR</x:String>
                                    <x:String>CHN</x:String>
                                </Picker.Items>
                            </Picker>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="5">
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                <CheckBox x:Name="EggCheck" Color="White" CheckedChanged="OnEggCheckedChanged"/>
                                <Label Text="Huevo" TextColor="White" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                <CheckBox x:Name="InfectedCheck" Color="White"/>
                                <Label Text="Infectado" TextColor="White" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                                <CheckBox x:Name="CuredCheck" Color="White"/>
                                <Label Text="Curado" TextColor="White" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <Border x:Name="BorderExtra" IsVisible="False" Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,15,0,0">
                            <VerticalStackLayout Spacing="10">

                                <Grid x:Name="GridCatchRate" IsVisible="False" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" WidthRequest="70">
                                        <Label Text="Catch Rate" TextColor="Gray" FontSize="11"/>
                                        <Entry x:Name="txtCatchRate" Text="255" Keyboard="Numeric" TextColor="White" BackgroundColor="#202020" FontSize="13" TextChanged="OnCatchRateChanged"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="Clear" HeightRequest="35" Padding="10,0" FontSize="12" BackgroundColor="#404040" TextColor="White" Clicked="OnClearClicked" VerticalOptions="End"/>
                                    <Button Grid.Column="3" Text="Reset" HeightRequest="35" Padding="10,0" FontSize="12" BackgroundColor="#404040" TextColor="White" Clicked="OnResetClicked" VerticalOptions="End"/>
                                </Grid>

                                <HorizontalStackLayout x:Name="LayoutNSparkle" Spacing="5" IsVisible="False">
                                    <CheckBox x:Name="chkNSparkle" Color="Cyan" CheckedChanged="OnNSparkleChanged"/>
                                    <Label Text="N's Sparkle (Gen 5)" TextColor="White" VerticalOptions="Center" FontSize="12"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout x:Name="LayoutShadowFields" Spacing="10" IsVisible="False">
                                    <BoxView HeightRequest="1" Color="#333" Margin="0,5"/>

                                    <Grid ColumnDefinitions="*, *">
                                        <Label Grid.Column="0" Text="Datos Shadow" FontAttributes="Bold" TextColor="Cyan" FontSize="11" VerticalOptions="Center"/>
                                        <HorizontalStackLayout x:Name="LayoutActive" Grid.Column="1" Spacing="5" HorizontalOptions="End">
                                            <CheckBox x:Name="chkActive" Color="Cyan" IsChecked="True"/>
                                            <Label Text="Active" TextColor="White" VerticalOptions="Center" FontSize="12"/>
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Shadow ID" TextColor="Gray" FontSize="11"/>
                                            <Entry x:Name="txtShadowID" Text="0" Keyboard="Numeric" TextColor="White" BackgroundColor="#202020" FontSize="13" TextChanged="OnShadowIDChanged"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Heart Gauge" TextColor="Gray" FontSize="11"/>
                                            <Entry x:Name="txtHeartGauge" Text="0" Keyboard="Numeric" TextColor="White" BackgroundColor="#202020" FontSize="13" TextChanged="OnHeartGaugeChanged"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <HorizontalStackLayout Spacing="5">
                                        <CheckBox x:Name="chkIsShadow" Color="Cyan" CheckedChanged="OnShadowChanged"/>
                                        <Label Text="Es Shadow" TextColor="White" VerticalOptions="Center" FontSize="12"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>




                    <!--TAB ENCUENTRO -->
                    <VerticalStackLayout x:Name="TabEncuentro" Spacing="15" Padding="10" IsVisible="False">

                        <Border Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" Padding="10" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="120, *">
                                    <Label x:Name="lblJuegoOriginalForm" Text="Juego original:" TextColor="White" VerticalOptions="Center" FontSize="13"/>
                                    <Border Grid.Column="1" Stroke="Gray" StrokeThickness="1" BackgroundColor="Black" Padding="10,8" StrokeShape="RoundRectangle 5">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="AbrirBuscadorJuego_Tapped"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label x:Name="lblJuegoOrigen" Text="Seleccionar..." TextColor="White" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="120, *">
                                    <Label x:Name="lblVersionBattleForm" Text="Versión de Batalla:" TextColor="White" VerticalOptions="Center" FontSize="13"/>
                                    <Border Grid.Column="1" Stroke="Gray" StrokeThickness="1" BackgroundColor="Black" Padding="10,8" StrokeShape="RoundRectangle 5">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="AbrirBuscadorBatalla_Tapped"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label x:Name="lblVersionBatalla" Text="(Ninguno)" TextColor="White" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" Padding="10" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Datos de Encuentro" FontAttributes="Bold" TextColor="#AAAAAA" FontSize="12"/>

                                <Grid ColumnDefinitions="120, *">
                                    <Label Text="Lugar:" TextColor="White" VerticalOptions="Center" FontSize="13"/>
                                    <Border Grid.Column="1" Stroke="Gray" StrokeThickness="1" BackgroundColor="Black" Padding="10,8" StrokeShape="RoundRectangle 5">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="AbrirBuscadorLugar_Tapped"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label x:Name="lblLugarEncuentro" Text="-(00000)" TextColor="White" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="120, *">
                                    <Label x:Name="lblPokeballForm" Text="Ball:" TextColor="White" VerticalOptions="Center" FontSize="13"/>

                                    <Border Grid.Column="1" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="Black" Padding="10,8">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="AbrirBuscadorBall_Tapped"/>
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <Image x:Name="imgPokeBall" Grid.Column="0" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Aspect="AspectFit"/>
                                            <Label x:Name="lblPokeBall" Grid.Column="1" Text="Poké Ball" TextColor="White" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                            <Label Grid.Column="2" Text="▼" TextColor="Gray" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="120, *">
                                    <Label Text="Fecha:" TextColor="White" VerticalOptions="Center" FontSize="13"/>
                                    <DatePicker Grid.Column="1" x:Name="dateEncuentro" TextColor="White" BackgroundColor="#202020" Format="dd/MM/yyyy" DateSelected="OnMetDateSelected"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="5">
                                        <Label x:Name="lblLevelForm" Text="Nivel:" TextColor="White" VerticalOptions="Center" FontSize="13"/>
                                        <Entry x:Name="txtMetLevel" Text="1" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" WidthRequest="50" HorizontalTextAlignment="Center" TextChanged="OnMetLevelChanged"/>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                        <Label x:Name="lblObedienciaForm" Text="Obed.:" TextColor="White" VerticalOptions="Center" FontSize="13"/>
                                        <Entry x:Name="txtObedienceLevel" Text="0" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" WidthRequest="50" HorizontalTextAlignment="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <HorizontalStackLayout Spacing="10">
                                    <CheckBox x:Name="chkFateful" Color="White" CheckedChanged="OnFatefulCheckedChanged"/>
                                    <Label Text="Encuentro Fatídico" TextColor="White" VerticalOptions="Center" FontSize="13"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                        <Border Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" Padding="10" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="10">

                                <HorizontalStackLayout Spacing="10">
                                    <CheckBox x:Name="chkIsEgg" Color="White" CheckedChanged="OnEggCheckedChanged"/>
                                    <Label Text="Como huevo" TextColor="White" VerticalOptions="Center" FontAttributes="Bold"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout x:Name="LayoutHuevo" Spacing="10" IsVisible="False">
                                    <Grid ColumnDefinitions="120, *">
                                        <Label Text="Lugar (Huevo):" TextColor="White" VerticalOptions="Center" FontSize="12"/>
                                        <Border Grid.Column="1" Stroke="Gray" StrokeThickness="1" BackgroundColor="Black" Padding="10,8" StrokeShape="RoundRectangle 5">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="AbrirBuscadorLugarHuevo_Tapped"/>
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label x:Name="lblLugarHuevo" Text="-(00000)" TextColor="White" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="▼" TextColor="Gray" VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="120, *">
                                        <Label Text="Fecha:" TextColor="White" VerticalOptions="Center" FontSize="13"/>
                                        <DatePicker Grid.Column="1" x:Name="dateHuevo" TextColor="White" BackgroundColor="#202020" Format="dd/MM/yyyy"/>
                                    </Grid>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>


                    <!--TAB ESTADISTICAS -->
                    <VerticalStackLayout x:Name="TabStats" Spacing="15" Padding="10" IsVisible="False">

                        <Border Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" StrokeShape="RoundRectangle 10" Padding="10">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="60, 40, *, *, 50" ColumnSpacing="5" RowSpacing="8">

                                <Label Text="Stat" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Start"/>
                                <Label Text="Base" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center"/>
                                <Label Text="IVs" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center"/>
                                <Label Text="EVs" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center"/>
                                <Label Text="Total" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center"/>

                                <Label Grid.Row="1" Text="HP" TextColor="White" VerticalOptions="Center"/>
                                <Label x:Name="lblBaseHP" Grid.Row="1" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry x:Name="txtIVHP" Grid.Row="1" Grid.Column="2" Text="31" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Entry x:Name="txtEVHP" Grid.Row="1" Grid.Column="3" Text="0" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Label x:Name="lblStatHP" Grid.Row="1" Grid.Column="4" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                                <Label x:Name="lblNameAtk" Grid.Row="2" Text="Atk" TextColor="White" VerticalOptions="Center"/>
                                <Label x:Name="lblBaseAtk" Grid.Row="2" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry x:Name="txtIVAtk" Grid.Row="2" Grid.Column="2" Text="31" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Entry x:Name="txtEVAtk" Grid.Row="2" Grid.Column="3" Text="0" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Label x:Name="lblStatAtk" Grid.Row="2" Grid.Column="4" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                                <Label x:Name="lblNameDef" Grid.Row="3" Text="Def" TextColor="White" VerticalOptions="Center"/>
                                <Label x:Name="lblBaseDef" Grid.Row="3" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry x:Name="txtIVDef" Grid.Row="3" Grid.Column="2" Text="31" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Entry x:Name="txtEVDef" Grid.Row="3" Grid.Column="3" Text="0" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Label x:Name="lblStatDef" Grid.Row="3" Grid.Column="4" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                                <Label x:Name="lblNameSpa" Grid.Row="4" Text="SpA" TextColor="White" VerticalOptions="Center"/>
                                <Label x:Name="lblBaseSpa" Grid.Row="4" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry x:Name="txtIVSpa" Grid.Row="4" Grid.Column="2" Text="31" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Entry x:Name="txtEVSpa" Grid.Row="4" Grid.Column="3" Text="0" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Label x:Name="lblStatSpa" Grid.Row="4" Grid.Column="4" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                                <Label x:Name="lblNameSpd" Grid.Row="5" Text="SpD" TextColor="White" VerticalOptions="Center"/>
                                <Label x:Name="lblBaseSpd" Grid.Row="5" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry x:Name="txtIVSpd" Grid.Row="5" Grid.Column="2" Text="31" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Entry x:Name="txtEVSpd" Grid.Row="5" Grid.Column="3" Text="0" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Label x:Name="lblStatSpd" Grid.Row="5" Grid.Column="4" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                                <Label x:Name="lblNameSpe" Grid.Row="6" Text="Spe" TextColor="White" VerticalOptions="Center"/>
                                <Label x:Name="lblBaseSpe" Grid.Row="6" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Entry x:Name="txtIVSpe" Grid.Row="6" Grid.Column="2" Text="31" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Entry x:Name="txtEVSpe" Grid.Row="6" Grid.Column="3" Text="0" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnStatChanged"/>
                                <Label x:Name="lblStatSpe" Grid.Row="6" Grid.Column="4" Text="0" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                                <Grid Grid.Row="7" Grid.ColumnSpan="5" ColumnDefinitions="*,*">
                                    <Button Grid.Column="0" Text="Random IVs" HeightRequest="35" Margin="0,5,5,0" BackgroundColor="#303030" TextColor="White" Clicked="OnRandomizeIVs"/>
                                    <Button Grid.Column="1" Text="Random EVs" HeightRequest="35" Margin="5,5,0,0" BackgroundColor="#303030" TextColor="White" Clicked="OnRandomizeEVs"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" StrokeShape="RoundRectangle 10" Padding="10">
                            <VerticalStackLayout Spacing="10">

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Tera Type:" TextColor="White" WidthRequest="80" VerticalOptions="Center"/>
                                    <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="#303030" Padding="0" HeightRequest="40" HorizontalOptions="FillAndExpand">
                                        <Picker x:Name="TeraTypePicker" TextColor="White" TitleColor="Gray" BackgroundColor="Transparent" SelectedIndexChanged="OnTeraTypeChanged"/>
                                    </Border>
                                </HorizontalStackLayout>

                                <Grid ColumnDefinitions="Auto, Auto, *">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                        <Label Text="D-Level:" TextColor="White" VerticalOptions="Center"/>
                                        <Entry x:Name="txtDynamaxLevel" Text="0" WidthRequest="40" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White" HorizontalTextAlignment="Center" TextChanged="OnDynamaxLevelChanged"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="5" Margin="20,0,0,0" VerticalOptions="Center">
                                        <CheckBox x:Name="chkGigantamax" Color="Cyan" CheckedChanged="OnGigantamaxChanged"/>
                                        <Label Text="G-Max" TextColor="White" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                        <Border Stroke="#333" StrokeThickness="1" BackgroundColor="#151515" StrokeShape="RoundRectangle 10" Padding="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Concursos" FontAttributes="Bold" TextColor="#AAAAAA" FontSize="12"/>
                                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                                    <VerticalStackLayout>
                                        <Label Text="Cool" TextColor="Gray" FontSize="11"/>
                                        <Entry x:Name="txtContestCool" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Beauty" TextColor="Gray" FontSize="11"/>
                                        <Entry x:Name="txtContestBeauty" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="Cute" TextColor="Gray" FontSize="11"/>
                                        <Entry x:Name="txtContestCute" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1">
                                        <Label Text="Smart" TextColor="Gray" FontSize="11"/>
                                        <Entry x:Name="txtContestSmart" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                        <Label Text="Tough" TextColor="Gray" FontSize="11"/>
                                        <Entry x:Name="txtContestTough" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="2">
                                        <Label Text="Sheen" TextColor="Gray" FontSize="11"/>
                                        <Entry x:Name="txtContestSheen" Keyboard="Numeric" BackgroundColor="#202020" TextColor="White"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                </Grid>
            </ContentView>
        </ScrollView>

    </Grid>
</ContentPage>