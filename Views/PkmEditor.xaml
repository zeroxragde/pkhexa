                                <Label Grid.Row="6" Text="Spe" TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label x:Name="lblBaseSpe" Grid.Row="6" Grid.Column="1" Text="0" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
