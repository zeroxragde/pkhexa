                            <Entry x:Name="txtPP4" Grid.Row="4" Grid.Column="1" Text="0" TextColor="White" BackgroundColor="#2D2D30" HorizontalTextAlignment="Center"/>
                            <Picker x:Name="pkPPUp4" Grid.Row="4" Grid.Column="2" TextColor="White" BackgroundColor="#2D2D30">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>0</x:String>
                                        <x:String>1</x:String>
                                        <x:String>2</x:String>
                                        <x:String>3</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <CheckBox x:Name="chkMastery4" Grid.Row="4" Grid.Column="3" Color="Gold" IsVisible="False"/>

                        </Grid>
                        <VerticalStackLayout x:Name="SectionRelearn" Spacing="8">
                            <Label Text="Recordar movimientos (Relearn)" TextColor="Gray" FontSize="12"/>
