                                    <Picker x:Name="pkRelearn1" Title="(Ninguno)" TextColor="White" BackgroundColor="#2D2D30"/>
                                    <Picker x:Name="pkRelearn2" Title="(Ninguno)" TextColor="White" BackgroundColor="#2D2D30"/>
                                    <Picker x:Name="pkRelearn3" Title="(Ninguno)" TextColor="White" BackgroundColor="#2D2D30"/>
                                    <Picker x:Name="pkRelearn4" Title="(Ninguno)" TextColor="White" BackgroundColor="#2D2D30"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="↺" BackgroundColor="#3E3E42" TextColor="White" CornerRadius="4"/>
                            </Grid>
