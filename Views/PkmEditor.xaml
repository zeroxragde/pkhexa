                                </Grid>

                                <HorizontalStackLayout x:Name="LayoutTeraOriginal" Spacing="15" IsVisible="False">
                                    <Label Text="Tera OG:" TextColor="White" WidthRequest="80" VerticalOptions="Center"/>
