                                        <x:String>1</x:String>
                                        <x:String>2</x:String>
                                        <x:String>3</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <CheckBox x:Name="chkMastery2" Grid.Row="2" Grid.Column="3" Color="Gold" IsVisible="False"/>

