                    <!--TAB OT -->
                    <VerticalStackLayout x:Name="TabOT" Spacing="15" Padding="10" IsVisible="False">
                        <Label Text="Próximamente: Entrenador Original" TextColor="Yellow" HorizontalOptions="Center"/>
