                                        <Label Text="Alpha" 
                                               TextColor="White"
                                               VerticalOptions="Center"/>           
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout x:Name="hsNoble" IsVisible="False" Spacing="5">
                                        <CheckBox x:Name="chkNoble" 
                                                  Color="Gold"
                                                  VerticalOptions="Center"/>

                                        <Label Text="Noble" 
                                               TextColor="White"
                                               VerticalOptions="Center"/>       
                                    </HorizontalStackLayout>

                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Border>


